{
	"cli": {
		"version": ">= 18.0.5",
		"appVersionSource": "local",
		"promptToConfigurePushNotifications": false
	},
	"build": {
		"development-build": {
			"developmentClient": true,
			"distribution": "internal",
			"ios": {
				"image": "macos-tahoe-26.5-xcode-26.6",
				"simulator": true,
				"resourceClass": "medium"
			},
			"android": {
				"buildType": "apk"
			},
			"env": {},
			"channel": "development-build",
			"environment": "development"
		},
		"development": {
			"developmentClient": false,
			"distribution": "internal",
			"ios": {
				"image": "macos-tahoe-26.5-xcode-26.6",
				"simulator": true,
				"resourceClass": "medium"
			},
			"android": {
				"buildType": "apk",
				"resourceClass": "medium"
			},
			"env": {
				"EAS_BUILD_ENABLE_COCOAPODS_CACHE": "1",
				"APP_ENV": "dev"
			},
			"channel": "development",
			"environment": "development"
		},
		"production": {
			"ios": {
				"image": "macos-tahoe-26.5-xcode-26.6",
				"resourceClass": "medium",
				"applicationArchivePath": "ios/build/*.ipa"
			},
			"android": {
				"resourceClass": "medium",
				"applicationArchivePath": "android/app/build/outputs/**/*.{apk,aab}"
			},
			"env": {
				"EAS_BUILD_ENABLE_COCOAPODS_CACHE": "1",
				"APP_ENV": "prod",
				"SENTRY_ALLOW_FAILURE": "true"
			},
			"channel": "0.13.0",
			"environment": "production"
		}
	},
	"submit": {
		"production": {}
	}
}

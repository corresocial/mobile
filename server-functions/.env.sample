# Este arquivo serve SOMENTE de entrada para o setup_secrets.sh, que envia os
# valores para o Secret Manager. As funções não leem o .env nem .env.yaml.
#
#   cp .env.sample .env    # preencha com as chaves NOVAS (rotacionadas)
#   bash setup_secrets.sh  # cria/atualiza os segredos
#
# Formato: CHAVE=valor, um por linha, sem comentário na mesma linha.
# Nunca commite o .env.

# Webhooks do Discord (Configurações do servidor > Integrações > Webhooks)
# Usados pela discordIntegration (service account fn-discord)
FALECONOSCO_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
ERROS_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DENUNCIAR_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Algolia (https://dashboard.algolia.com > Settings > API Keys)
# Usados pela searchPostsByAlgolia (fn-search). Use uma chave só de busca
# (ACL "search"), não a Admin API Key.
ALGOLIA_ID=YOUR_ALGOLIA_APP_ID
ALGOLIA_KEY=YOUR_ALGOLIA_SEARCH_API_KEY

# Stripe (https://dashboard.stripe.com/apikeys)
# Usada pela stripeApi (fn-stripe). Prefira uma restricted key (rk_live_...).
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# STRIPE_WEBHOOK_SECRET não é mais usado: o webhook do Stripe (stripeWebhook)
# não está implantado. Se voltar a ser, adicione-o ao setup_secrets.sh.

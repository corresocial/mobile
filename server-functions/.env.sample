# Discord Webhooks Configuration
# Get your webhook URLs from Discord Server Settings > Integrations > Webhooks
FALECONOSCO_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
ERROS_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DENUNCIAR_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Notion Configuration (Fale Conosco / denúncias / erros)
# Internal integration token from https://www.notion.so/profile/integrations
# The database must be shared with this integration
NOTION_FALECONOSCO_KEY=ntn_YOUR_NOTION_INTEGRATION_TOKEN
NOTION_FALECONOSCO_ID=YOUR_NOTION_DATABASE_ID

# Algolia Configuration
# Get your credentials from https://www.algolia.com/account/api-keys
ALGOLIA_ID=YOUR_ALGOLIA_APP_ID
ALGOLIA_KEY=YOUR_ALGOLIA_API_KEY

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

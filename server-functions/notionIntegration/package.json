{
    "name": "notion-integration",
    "description": "Secure Notion proxy",
    "main": "index.ts",
    "scripts": {
        "start": "tsc && node deploy/index.js",
        "dev": "ts-node-dev -r --respawn --transpile-only --ignore-watch node_modules index.ts",
        "build": "tsc",
        "deploy": "npm-run-all build deploy-cloud-function",
        "deploy-cloud-function": "cd deploy && gcloud functions deploy notionIntegration --gen2 --runtime nodejs22 --trigger-http --entry-point notionIntegration --region southamerica-east1 --allow-unauthenticated --env-vars-file ../.env.yaml"
    },
    "dependencies": {
        "axios": "^1.13.2",
        "firebase-admin": "^13.6.0",
        "firebase-functions": "^7.0.1"
    },
    "devDependencies": {
        "@types/node": "^22.19.0",
        "npm-run-all": "^4.1.5",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    },
    "version": "1.0.0",
    "keywords": [],
    "author": "",
    "license": "ISC"
}

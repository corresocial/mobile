rules_version = '2';

// Buckets sem uso pelo app (corresocialapp-backup, corresocialapp-backupt,
// corresocialapp). Só o Admin SDK (que ignora regras) acessa.
// Antes desta versão, corresocialapp-backup permitia leitura pública e escrita
// por qualquer usuário logado em pictures/**.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
